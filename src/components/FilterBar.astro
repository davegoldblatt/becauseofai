---
// Client-side filters driven by URL params, so a filtered view is shareable:
// /?window=in&evidence=A  (values may be comma-separated: domain=medicine,work)
// Without JavaScript every entry shows.
import { DOMAINS, EVIDENCE, ATTRIBUTION, WINDOW, AI_TYPES } from "../schema.ts";
import { DOMAIN_LABEL, EVIDENCE_LABEL, ATTRIBUTION_LABEL, WINDOW_LABEL, AI_TYPE_LABEL } from "../lib/format.ts";
interface Props { total: number }
const { total } = Astro.props;
const groups = [
  { key: "domain", label: "Domain", values: DOMAINS.map((v) => [v, DOMAIN_LABEL[v]]) },
  { key: "evidence", label: "Evidence", values: EVIDENCE.map((v) => [v, EVIDENCE_LABEL[v]]) },
  { key: "attribution", label: "Attribution", values: ATTRIBUTION.map((v) => [v, ATTRIBUTION_LABEL[v]]) },
  { key: "window", label: "Window", values: WINDOW.map((v) => [v, WINDOW_LABEL[v]]) },
  { key: "ai_type", label: "AI type", values: AI_TYPES.map((v) => [v, AI_TYPE_LABEL[v]]) },
];
---
<details class="filters" data-filters data-pagefind-ignore>
  <summary><span>Filter entries</span><span class="muted small" data-filter-summary>all shown</span></summary>
  {groups.map((g) => (
    <div class="filter-group" role="group" aria-label={g.label}>
      <span class="g">{g.label}</span>
      {g.values.map(([v, label]) => (
        <button type="button" data-filter={g.key} data-value={v} aria-pressed="false">{label}</button>
      ))}
    </div>
  ))}
</details>
<p class="filter-status" data-filter-status hidden>
  <span data-filter-count></span>
  <button type="button" data-filter-clear>Clear filters</button>
</p>
<script define:vars={{ total }}>
  const KEYS = ["domain", "evidence", "attribution", "window", "ai_type"];
  const DATA = { domain: "domain", evidence: "evidence", attribution: "attribution", window: "window", ai_type: "aiType" };
  function init() {
  const box = document.querySelector("[data-filters]");
  const status = document.querySelector("[data-filter-status]");
  const countEl = document.querySelector("[data-filter-count]");
  const summaryEl = document.querySelector("[data-filter-summary]");
  const cards = Array.from(document.querySelectorAll(".entry-list .card"));
  if (box && status && countEl && summaryEl) {
    const state = Object.fromEntries(KEYS.map((k) => [k, new Set()]));
    // Only values that have a button are valid; anything else in the URL is dropped.
    const allowed = Object.fromEntries(KEYS.map((k) => [k, new Set(Array.from(box.querySelectorAll(`button[data-filter="${k}"]`)).map((b) => b.dataset.value))]));
    function readUrl() {
      const q = new URLSearchParams(location.search);
      for (const k of KEYS) {
        state[k] = new Set((q.get(k) || "").split(",").filter((v) => allowed[k].has(v)));
      }
    }
    function writeUrl() {
      const q = new URLSearchParams();
      for (const k of KEYS) if (state[k].size) q.set(k, Array.from(state[k]).join(","));
      const s = q.toString();
      history.replaceState(null, "", s ? `${location.pathname}?${s}` : location.pathname);
    }
    function apply() {
      let shown = 0;
      for (const card of cards) {
        const ok = KEYS.every((k) => !state[k].size || state[k].has(card.dataset[DATA[k]]));
        card.hidden = !ok;
        if (ok) shown++;
      }
      for (const b of box.querySelectorAll("button[data-filter]")) {
        b.setAttribute("aria-pressed", String(state[b.dataset.filter].has(b.dataset.value)));
      }
      const active = KEYS.reduce((n, k) => n + state[k].size, 0);
      status.hidden = active === 0;
      countEl.textContent = `Showing ${shown} of ${total}`;
      summaryEl.textContent = active ? `${shown} of ${total} shown` : "all shown";
      if (active) box.open = true;
    }
    box.addEventListener("click", (ev) => {
      const b = ev.target.closest("button[data-filter]");
      if (!b) return;
      const set = state[b.dataset.filter];
      set.has(b.dataset.value) ? set.delete(b.dataset.value) : set.add(b.dataset.value);
      writeUrl();
      apply();
    });
    status.querySelector("[data-filter-clear]").addEventListener("click", () => {
      for (const k of KEYS) state[k].clear();
      writeUrl();
      apply();
    });
    addEventListener("popstate", () => { readUrl(); apply(); });
    readUrl();
    apply();
  }
  }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init);
  else init();
</script>
