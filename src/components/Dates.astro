---
// Achieved and Published, side by side, same weight. Achieved follows the date
// state the entry actually carries (range, ongoing, open, end-only, none). When
// publication trails the benefit by a year or more, say so: that gap is the
// registry's point.
import type { Entry } from "../schema.ts";
import { achievedState, fmtDate, isoDate, lagLine } from "../lib/format.ts";
interface Props { entry: Entry }
const { entry: e } = Astro.props;
const a = achievedState(e);
const lag = lagLine(e);
---
<div class="dates" data-pagefind-ignore>
  <span><span class="lbl">Achieved</span><span class="val">{a.text}</span></span>
  <span><span class="lbl">Published</span><time class="val" datetime={isoDate(e.dates.published)}>{fmtDate(e.dates.published)}</time></span>
  {lag && <span class="lag">{lag}</span>}
</div>
