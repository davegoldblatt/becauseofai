---
// The three grade badges. Three hue families; each links to its definition on
// /method. Never collapsed into one score. A null grade renders as "not graded"
// (not-yet entries), never as a blank.
import type { Entry } from "../schema.ts";
import { EVIDENCE_LABEL, ATTRIBUTION_LABEL, WINDOW_LABEL } from "../lib/format.ts";
interface Props { entry: Entry }
const { entry: e } = Astro.props;
const g = e.grades;
---
<div class="badges">
  {g.evidence ? (
    <a class={`badge badge-ev-${g.evidence}`} href={`/method#evidence-${g.evidence}`} title="Evidence grade">
      <span class="k">evidence</span> {EVIDENCE_LABEL[g.evidence]}
    </a>
  ) : (
    <a class="badge badge-none" href="/method#evidence"><span class="k">evidence</span> not graded</a>
  )}
  {g.attribution ? (
    <a class={`badge badge-at-${g.attribution}`} href={`/method#attribution-${g.attribution}`} title="Attribution grade">
      <span class="k">attribution</span> {ATTRIBUTION_LABEL[g.attribution]}
    </a>
  ) : (
    <a class="badge badge-none" href="/method#attribution"><span class="k">attribution</span> not graded</a>
  )}
  {g.window ? (
    <a class={`badge badge-wi-${g.window}`} href={`/method#window-${g.window}`} title="Window grade">
      <span class="k">window</span> {WINDOW_LABEL[g.window]}
    </a>
  ) : (
    <a class="badge badge-none" href="/method#window"><span class="k">window</span> not graded</a>
  )}
</div>
