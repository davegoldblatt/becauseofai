---
// A receipt mark next to a number: the verbatim sentence in the primary source
// that supports it, its locator, and a link to the source. A <details> so it
// works without JavaScript; the popover is the open state.
import type { Entry, ReceiptField } from "../schema.ts";
import { receiptsFor, hostOf } from "../lib/format.ts";
interface Props { entry: Entry; fields: ReceiptField[]; label: string }
const { entry: e, fields, label } = Astro.props;
const list = receiptsFor(e, ...fields);
---
{list.length > 0 && (
  <details class="rcpt" data-pagefind-ignore>
    <summary aria-label={`Receipt for ${label}`} title={`Receipt: the sentence in the primary source that supports ${label}`}><span class="sd">receipt</span></summary>
    <div class="rcpt-pop">
      {list.map((r) => { const s = e.sources[r.source]; return (
        <div class="rcpt-item">
          <q>{r.quote}</q>
          <span class="rcpt-loc">{r.locator}</span>
          {s && <a href={s.url} rel="noopener">{s.title}<span class="host"> · {hostOf(s.url)}</span></a>}
        </div>
      ); })}
    </div>
  </details>
)}
