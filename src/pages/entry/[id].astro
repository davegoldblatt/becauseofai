---
import Base from "../../layouts/Base.astro";
import Badges from "../../components/Badges.astro";
import Dates from "../../components/Dates.astro";
import { publishable, byId } from "../../lib/site.ts";
import { SITE } from "../../site.ts";
import { fmtDate, isoDate, primarySources, secondarySources, hostOf, effectLine, SECTION_LABEL, DOMAIN_LABEL, AI_TYPE_LABEL } from "../../lib/format.ts";

export function getStaticPaths() {
  return publishable.map((e) => ({ params: { id: e.id }, props: { entry: e } }));
}
const { entry: e } = Astro.props;
const url = `${SITE.url}/entry/${e.id}`;
const sectionHref = e.section === "because" ? "/" : e.section === "not-because" ? "/not-because-of-ai" : "/not-yet";
const related = (e.related ?? []).map((id) => byId.get(id)).filter((x) => x !== undefined);
const effect = effectLine(e);
const cite = `“${e.headline}” Because of AI, updated ${fmtDate(e.dates.updated)}. ${url}`;
---
<Base title={e.headline} description={e.summary} canonical={url}>
  <article class="entry" data-pagefind-body data-pagefind-meta={`section:${SECTION_LABEL[e.section]}`}>
    <header class="entry-head">
      <a class="section-link" href={sectionHref}>{SECTION_LABEL[e.section]} · rank {e.rank}</a>
      <h1 class="headline">{e.headline}</h1>
      <span class="impact">{e.impact}</span>
      <Badges entry={e} />
      <Dates entry={e} />
    </header>
    <p class="prose">{e.summary}</p>
    {e.caveat && <p class="prose muted">{e.caveat}</p>}
    {e.section === "not-yet" && e.what_would_change && (
      <div class="what-would-change"><span class="lbl">What would change this</span>{e.what_would_change}</div>
    )}
    <dl class="facts">
      {e.comparison && <><dt>Compared with</dt><dd>{e.comparison}</dd></>}
      {effect && <><dt>Effect</dt><dd>{effect}</dd></>}
      {e.reach && <><dt>Reach</dt><dd>{e.reach}</dd></>}
      <dt>Domain</dt><dd>{DOMAIN_LABEL[e.domain]} · {AI_TYPE_LABEL[e.ai_type]}</dd>
      {e.conflicts && <><dt>Conflicts</dt><dd>{e.conflicts}</dd></>}
      {e.section !== "not-yet" && e.what_would_change && <><dt>What would move the grade</dt><dd>{e.what_would_change}</dd></>}
    </dl>
    <h2>Sources</h2>
    <ul class="sources">
      {primarySources(e).map((s) => <li><span class="type">primary</span><a href={s.url} rel="noopener">{s.title}</a> <span class="muted small">({hostOf(s.url)})</span></li>)}
      {secondarySources(e).map((s) => <li><span class="type">secondary</span><a href={s.url} rel="noopener">{s.title}</a> <span class="muted small">({hostOf(s.url)})</span></li>)}
    </ul>
    {e.notes && (
      <>
        <h2>Editor's notes</h2>
        <p class="notes">{e.notes}</p>
      </>
    )}
    {related.length > 0 && (
      <>
        <h2>Related</h2>
        <ul class="prose">
          {related.map((r) => <li><a href={`/entry/${r.id}`}>{r.headline}</a></li>)}
        </ul>
      </>
    )}
    <h2>History</h2>
    <ul class="history">
      {[...e.history].reverse().map((h) => <li><time datetime={isoDate(h.date)}>{fmtDate(h.date)}</time><span>{h.note}</span></li>)}
    </ul>
    <h2>Cite this entry</h2>
    <div class="cite" data-pagefind-ignore>
      Permalink <a href={url}>{url}</a>
      <code>{cite}</code>
    </div>
  </article>
</Base>
