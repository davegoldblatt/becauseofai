---
import Base from "../layouts/Base.astro";
import Registry from "../components/Registry.astro";
import { notBecause } from "../lib/site.ts";
import { SITE } from "../site.ts";
---
<Base title="Not because of AI" description="Measured null and negative results for AI interventions, held to the same evidence bar as the wins." section="not-because" nameplate="full" ogImage={`${SITE.url}/og/not-because-of-ai.png`}>
  <h1 class="sr-only">Not because of AI</h1>
  <p class="lede">Trials and deployments where AI was measured against something and did not help, or made things worse. They sit here under the same grades as the wins. A registry that only records successes is advertising. A clean null tells you more about what AI does than most press releases.</p>
  <Registry entries={notBecause} section="not-because" />
</Base>
