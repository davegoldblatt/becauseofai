---
import Base from "../layouts/Base.astro";
import { publishable, heldList } from "../lib/site.ts";
import { fmtDate, isoDate, changeType, recordUrl, SECTION_LABEL, HELD_REASON_LABEL, HELD_REASON_DESCRIPTION, VENDOR_LABEL, type ChangeType } from "../lib/format.ts";
// Held entries are named here with their reason and both verdicts, as they are
// in /api/entries.json, but never linked: a held entry has no page.

type Row = { date: string; id: string; headline: string; note: string; type: ChangeType | null; rest: string };
const rows: Row[] = [];
for (const e of publishable) {
  for (const h of e.history) {
    const ct = changeType(h.note);
    rows.push({ date: isoDate(h.date), id: e.id, headline: e.headline, note: h.note, type: ct?.type ?? null, rest: ct?.rest ?? h.note });
  }
}
rows.sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : a.id.localeCompare(b.id)));
const days = new Map<string, Row[]>();
for (const r of rows) (days.get(r.date) ?? days.set(r.date, []).get(r.date)!).push(r);
---
<Base title="Changelog" description="Every change to every entry, newest first, with its type.">
  <h1 class="page-title">Changelog</h1>
  <p class="lede">Generated from each entry's history, newest first. A change carries a type when its note says so (added, upgraded, downgraded, updated, corrected, verified, removed, re-graded). Subscribe to <a href="/changes.xml">one item per change</a> or <a href="/feed.xml">one item per entry</a>.</p>
  {heldList.length > 0 && (
    <section class="log-day" id="held">
      <h2>Held</h2>
      <p class="chg-note">Entries the gate is holding, with the reason. A held entry is not counted, not linked, and not in the feeds until two models from different vendors agree on every number and grade; where they disagreed, both verdicts are here. <a href="/method#pipeline">How the gate works.</a></p>
      <ul>
        {heldList.map(({ entry: e, held: h, record }) => { const out = record?.record.verifier?.output as { summary?: string; grades?: { evidence: string | null; attribution: string | null; window: string | null } } | null | undefined; const ver = record?.record.verifier; return (
          <li class="chg held">
            <span class="chg-type"><span class="stamp stamp-xs stamp-held" title={HELD_REASON_DESCRIPTION[h.reason]}><span class="sd">{HELD_REASON_LABEL[h.reason]}</span></span></span>
            <div>
              <span class="chg-h">{e.headline}</span>
              <p class="chg-note">{SECTION_LABEL[e.section]} · since <time datetime={h.since}>{fmtDate(h.since)}</time> · {h.detail}{record && <> · <a href={recordUrl(record.path)} rel="noopener">record</a></>}</p>
              {ver && (
                <p class="chg-note">{record!.record.drafter ? `Drafter ${VENDOR_LABEL[record!.record.drafter.vendor]} graded ${e.grades.evidence ?? "–"} · ${e.grades.attribution ?? "–"} · ${e.grades.window ?? "–"}. ` : ""}Verifier {VENDOR_LABEL[ver.vendor]}{out?.grades ? ` graded ${out.grades.evidence ?? "–"} · ${out.grades.attribution ?? "–"} · ${out.grades.window ?? "–"}` : ver.error ? ` failed: ${ver.error}` : ""}{out?.summary ? `: ${out.summary}` : "."}</p>
              )}
            </div>
          </li>
        ); })}
      </ul>
    </section>
  )}
  {[...days.entries()].map(([date, items]) => (
    <section class="log-day">
      <h2><time datetime={date}>{fmtDate(date)}</time></h2>
      <ul>
        {items.map((r) => (
          <li class:list={["chg", r.type]}>
            <span class="chg-type">{r.type && <span class="stamp stamp-xs"><span class="sd">{r.type}</span></span>}</span>
            <div>
              <span class="chg-h"><a href={`/entry/${r.id}`}>{r.headline}</a></span>
              {r.rest && <p class="chg-note">{r.rest}</p>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
