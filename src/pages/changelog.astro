---
import Base from "../layouts/Base.astro";
import { publishable } from "../lib/site.ts";
import { fmtDate, isoDate } from "../lib/format.ts";

type Row = { date: string; id: string; headline: string; note: string };
const rows: Row[] = [];
for (const e of publishable) for (const h of e.history) rows.push({ date: isoDate(h.date), id: e.id, headline: e.headline, note: h.note });
rows.sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : a.id.localeCompare(b.id)));
const days = new Map<string, Row[]>();
for (const r of rows) (days.get(r.date) ?? days.set(r.date, []).get(r.date)!).push(r);
---
<Base title="Changelog" description="Every change to every entry, newest first.">
  <h1 class="page-title">Changelog</h1>
  <p class="lede">Generated from each entry's history. Newest first.</p>
  {[...days.entries()].map(([date, items]) => (
    <section class="log-day">
      <h2><time datetime={date}>{fmtDate(date)}</time></h2>
      <ul>
        {items.map((r) => <li><a href={`/entry/${r.id}`}>{r.headline}</a> <span class="muted">— {r.note}</span></li>)}
      </ul>
    </section>
  ))}
</Base>
