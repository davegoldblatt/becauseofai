---
// Base layout: head, masthead (nameplate, running head, section tabs, search,
// theme), main, footer. The nameplate reads BECAUSE OF AI, NOT BECAUSE OF AI,
// or NOT YET BECAUSE OF AI by section. Counts come from the loader.
import "../styles/global.css";
import { SITE, NAMEPLATE } from "../site.ts";
import { reviewedCounts as siteCounts, unreviewedCount } from "../lib/site.ts";
import type { Section } from "../schema.ts";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  // Title for link previews when the page <title> is too long for a card.
  ogTitle?: string;
  // Which nameplate to set. List pages pass their section and "full".
  section?: Section | null;
  nameplate?: "full" | "compact";
}
const {
  title,
  description = SITE.description,
  canonical,
  ogImage = `${SITE.url}/og/site.png`,
  ogTitle,
  section = null,
  nameplate = "compact",
} = Astro.props;
// Public route for this page. With file-format output the build-time pathname
// carries ".html" (and "/index.html" for the homepage); strip both so canonical
// URLs, titles, and navigation state use the clean route that is served.
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/").replace(/(.)\/$/, "$1") || "/";
const canonicalUrl = canonical ?? new URL(path === "/" ? "/" : path, SITE.url).toString();
const ogImageUrl = ogImage.includes("?") ? ogImage : `${ogImage}?v=${SITE.ogVersion}`;
const np = NAMEPLATE[section ?? "because"];
const tabs: { href: string; label: string; n: number; key: Section }[] = [
  { href: "/", label: "Because", n: siteCounts.because, key: "because" },
  { href: "/not-because-of-ai", label: "Not because", n: siteCounts["not-because"], key: "not-because" },
  { href: "/not-yet", label: "Not yet", n: siteCounts["not-yet"], key: "not-yet" },
];
const more = [
  { href: "/method", label: "Method" },
  { href: "/changelog", label: "Changelog" },
  { href: "/about", label: "About" },
];
const fullTitle = path === "/" ? `${SITE.name} — a registry of measured AI benefits` : `${title} — ${SITE.name}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name}: entries`} href="/feed.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name}: changes`} href="/changes.xml" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={SITE.domain} />
    <meta property="og:title" content={ogTitle ?? fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={`@${SITE.x}`} />
    <meta name="twitter:creator" content={`@${SITE.editorX}`} />
    <link rel="preload" href="/fonts/ArchivoCond-900.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Bricolage-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono-500.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        document.documentElement.classList.add("js");
        try {
          var t = localStorage.getItem("theme");
          if (t === "dark" || t === "light") document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    <!-- Analytics: none by default. To enable Plausible, uncomment:
    <script defer data-domain="becauseofai.org" src="https://plausible.io/js/script.js"></script>
    -->
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class:list={["masthead", `np-${nameplate}`]} data-pagefind-ignore>
      <div class="wrap">
        <a class="nameplate" href="/" style={`--np-em:${np.em}`}>
          {np.pre && <><span class:list={["np-pre", `np-pre-${section}`]}>{np.pre}</span>{" "}</>}<span class="np-rest">{np.rest}</span><span class="sr-only">, home</span>
        </a>
        <div class="running">
          <p class="running-head">{SITE.runningHead} · as of <time datetime={SITE.asOf}>{SITE.asOf}</time></p>
          <nav class="tabs" aria-label="Sections">
            {tabs.map((t) => (
              <a href={t.href} aria-current={section === t.key ? "page" : undefined}>{t.label} <b>{t.n}</b></a>
            ))}
            {unreviewedCount > 0 && <a class="tab-unrev" href="/changelog#awaiting-review" title="Published by the research run, not yet read by the editor">Unreviewed <b>{unreviewedCount}</b></a>}
          </nav>
          <nav class="more" aria-label="About the registry">
            {more.map((n) => (
              <a href={n.href} aria-current={path === n.href ? "page" : undefined}>{n.label}</a>
            ))}
          </nav>
          <form class="search" role="search" action="/search" method="get">
            <input type="search" name="q" placeholder="Search" aria-label="Search entries" data-search-input autocomplete="off" />
            <kbd aria-hidden="true">/</kbd>
          </form>
          <a class="search-link" href="/search" aria-label="Search">
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="6.5" cy="6.5" r="4.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M10 10l4.5 4.5" stroke="currentColor" stroke-width="2"/></svg>
          </a>
          <button class="theme" type="button" data-theme-toggle aria-label="Switch color theme">
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor"/></svg>
          </button>
        </div>
      </div>
    </header>
    <main id="main" class="wrap" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer" data-pagefind-ignore>
      <div class="wrap">
        <p class="foot-thesis">{SITE.thesis}</p>
        <nav class="foot-links" aria-label="Footer">
          <a href="/">Because of AI</a>
          <a href="/not-because-of-ai">Not because of AI</a>
          <a href="/not-yet">Not yet</a>
          <a href="/method">Method</a>
          <a href="/changelog">Changelog</a>
          <a href="/about">About</a>
          <a href="/search">Search</a>
          <a href={`${SITE.repo}/issues/new/choose`}>Submit or dispute an entry</a>
          <a href={SITE.repo}>Source</a>
          <a href="/feed.xml">RSS</a>
          <a href="/changes.xml">Changes RSS</a>
          <a href="/api/entries.json">JSON</a>
          <a href={`https://x.com/${SITE.x}`} rel="me">X</a>
        </nav>
        <p class="foot-meta">{SITE.name}. Independent, unfunded. Data as of {SITE.asOf}.</p>
      </div>
    </footer>
    <script>
      const root = document.documentElement;
      const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      function current(): "light" | "dark" {
        const t = root.dataset.theme;
        if (t === "dark" || t === "light") return t;
        return matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      btn?.addEventListener("click", () => {
        const next = current() === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch {}
      });
      // "/" or ⌘K / Ctrl+K focuses the header search; when the input is hidden
      // (narrow screens) they open the search page instead.
      const input = document.querySelector<HTMLInputElement>("[data-search-input]");
      addEventListener("keydown", (ev) => {
        const target = ev.target as HTMLElement | null;
        const typing = !!target?.closest?.("input, textarea, select, [contenteditable]");
        const combo = (ev.metaKey || ev.ctrlKey) && !ev.altKey && ev.key.toLowerCase() === "k";
        const slash = ev.key === "/" && !ev.metaKey && !ev.ctrlKey && !ev.altKey && !typing;
        if (!combo && !slash) return;
        ev.preventDefault();
        if (input && input.offsetParent !== null) {
          input.focus();
          input.select();
        } else {
          location.href = "/search";
        }
      });
    </script>
  </body>
</html>
